---
interface Props {
  brands: { src: string; name: string; scale?: number }[];
}
const { brands } = Astro.props;
/** Each logo ships two cuts: brand colours for the light sheet, a recoloured one for the dark. */
const dark = (src: string) => src.replace(/\.png$/, "-dark.png");
---
<ul class="brands">
  {brands.map((b) => (
    <li style={`--scale:${b.scale ?? 1}`}>
      <img class="on-dark" src={dark(b.src)} alt={`${b.name} logo`} loading="lazy" decoding="async" />
      <img class="on-light" src={b.src} alt="" aria-hidden="true" loading="lazy" decoding="async" />
    </li>
  ))}
</ul>

<style>
  .brands {
    grid-column: prose / -1;
    grid-row: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2.5rem;
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
  }
  .brands img {
    display: block;
    height: calc(1.75rem * var(--scale, 1));
    width: auto;
    max-width: 11rem;
    object-fit: contain;
  }
  /* one cut per sheet; specificity has to beat `.brands img` above */
  .brands .on-light { display: none; }
  :global([data-theme="light"]) .brands .on-light { display: block; }
  :global([data-theme="light"]) .brands .on-dark { display: none; }

  @media (max-width: 52rem) {
    .brands { grid-column: 1 / -1; grid-row: auto; gap: 1rem 1.75rem; }
    .brands img { height: calc(1.4rem * var(--scale, 1)); }
  }
</style>
