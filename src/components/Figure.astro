---
import { plates, type PlateKey } from "./plates";

interface Props {
  plate?: PlateKey;
  image?: string;
  imageAlt?: string;
  number: string;
  caption: string;
  width: "column" | "full";
}
const { plate, image, imageAlt, number, caption, width } = Astro.props;
const Plate = plate ? plates[plate] : undefined;
---
<figure class={`figure figure-${width}`}>
  {image
    ? <img src={image} alt={imageAlt ?? caption} loading="lazy" decoding="async" />
    : Plate && <Plate />}
  <figcaption class="u-mono">
    <span class="fig">Fig. {number}</span> — {caption}
    {!image && <span class="hint" aria-hidden="true">scroll →</span>}
  </figcaption>
</figure>

<style>
  .figure { margin: 2.5rem 0 0; }
  .figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }
  .figure-column { grid-column: prose / -1; }
  .figure-full { grid-column: 1 / -1; }

  figcaption {
    margin-top: 0.85rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    line-height: 1.7;
  }
  .fig { color: var(--oxblood); }
  .hint { display: none; float: right; margin-left: 1rem; }

  /* Wide plates scroll rather than shrink their labels to nothing. */
  @media (max-width: 52rem) {
    .hint { display: inline; }
  }

  @media (max-width: 52rem) {
    .figure-column, .figure-full { grid-column: 1 / -1; }
  }
</style>
