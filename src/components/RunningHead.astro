---
import { site } from "../site";
---
<header class="running">
  <div class="sheet running-inner">
    <span class="u-mono">{site.name}</span>
    <span class="u-mono middle">Work record</span>
    <span class="u-mono right">
      <span class="span">2021—{site.year}</span>
      <button type="button" id="theme-toggle" class="u-mono toggle no-print" aria-pressed="false">
        <span class="label-light">Dark</span><span class="label-dark">Light</span>
      </button>
    </span>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    const root = document.documentElement;
    const sync = () => btn.setAttribute("aria-pressed", String(root.getAttribute("data-theme") !== "light"));
    sync();
    btn.addEventListener("click", () => {
      const light = root.getAttribute("data-theme") === "light";
      if (light) root.removeAttribute("data-theme");
      else root.setAttribute("data-theme", "light");
      try { localStorage.setItem("sheet-theme", light ? "dark" : "light"); } catch (_) {}
      sync();
    });
  })();
</script>

<style>
  .running { border-bottom: 1px solid var(--rule); }
  .running-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
    color: var(--muted);
  }
  .middle { flex: 0 1 auto; }
  .right { display: inline-flex; align-items: baseline; gap: 1.25rem; }
  .toggle {
    appearance: none;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--rule-strong);
    padding: 0 0 1px;
    margin: 0;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition: color var(--step) linear, border-color var(--step) linear;
  }
  .toggle:hover { color: var(--navy); border-bottom-color: currentColor; }
  .toggle:focus-visible { outline: 2px solid var(--navy); outline-offset: 3px; }
  .label-light { display: none; }
  :global([data-theme="light"]) .label-light { display: inline; }
  :global([data-theme="light"]) .label-dark { display: none; }

  @media (max-width: 40rem) {
    .middle { display: none; }
  }
</style>
