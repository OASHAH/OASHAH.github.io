---
/** 03 — One operations platform, four marketplaces. */
const tenants = ["DUBIZZLE", "BAYUT", "OLX", "LAMUDI", "ZAMEEN"];
---
<div class="plate-scroll" style="--plate-min: 34rem">
  <svg class="plate" viewBox="0 0 640 260" role="img"
       aria-label="Diagram: four marketplaces — dubizzle, OLX, Lamudi and Zameen — sit above one shared automotive operations platform covering CRM, auctions, inspection, leads, scheduling and reporting.">
    <defs>
      <marker id="ah-db" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0 L8 4 L0 8 z" class="head" />
      </marker>
    </defs>

    <text x="60" y="20" class="t-ink">MARKETPLACES</text>
    <line class="line" x1="66" y1="30" x2="66" y2="152" />

    {tenants.map((t, i) => (
      <>
        <line class="line" x1="66" y1={46 + i * 28} x2="106" y2={46 + i * 28} />
        <text x="114" y={50 + i * 28}>{t}</text>
      </>
    ))}

    <line class="line" x1="66" y1="152" x2="320" y2="152" />
    <path class="line" marker-end="url(#ah-db)" d="M320 152 L320 178" />

    <rect class="box-in" x="120" y="182" width="400" height="60" />
    <text x="320" y="205" text-anchor="middle" class="t-ink">AUTOMOTIVE OPERATIONS</text>
    <text x="320" y="224" text-anchor="middle" class="t-sm">CRM · AUCTIONS · INSPECTION · LEADS · SCHEDULING · REPORTING</text>

    <text x="400" y="50" class="t-sm">ONE MULTI-TENANT CODEBASE</text>
    <text x="400" y="66" class="t-sm">FIVE TENANTS IN PRODUCTION</text>
    <text x="400" y="82" class="t-sm">350+ INTERNAL USERS</text>
    <line class="line-in" x1="392" y1="38" x2="392" y2="90" />
  </svg>
</div>
