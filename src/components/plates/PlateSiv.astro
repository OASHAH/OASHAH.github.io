---
/** 01 — Address Space: one governed surface over many tenants. */
---
<div class="plate-scroll" style="--plate-min: 34rem">
  <svg class="plate" viewBox="0 0 640 300" role="img"
       aria-label="Diagram: 150-plus tenants address a KrakenD gateway, which composes responses from the Address Space service over PostgreSQL and OpenSearch; Kafka keeps the search layer in step and carried the legacy estate across.">
    <defs>
      <marker id="ah-siv" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0 L8 4 L0 8 z" class="head" />
      </marker>
    </defs>

    <!-- tenants -->
    <text x="120" y="18">150+ TENANTS</text>
    <rect class="box" x="120" y="26" width="104" height="28" />
    <rect class="box" x="248" y="26" width="104" height="28" />
    <rect class="box" x="376" y="26" width="104" height="28" />
    <text x="172" y="44" text-anchor="middle" class="t-sm">TENANT 001</text>
    <text x="300" y="44" text-anchor="middle" class="t-sm">TENANT 002</text>
    <text x="428" y="44" text-anchor="middle" class="t-sm">TENANT 003</text>
    <text x="500" y="44">… 150+</text>

    <path class="line" marker-end="url(#ah-siv)" d="M172 54 L172 88" />
    <path class="line" marker-end="url(#ah-siv)" d="M300 54 L300 88" />
    <path class="line" marker-end="url(#ah-siv)" d="M428 54 L428 88" />

    <!-- gateway -->
    <rect class="box-in" x="80" y="92" width="480" height="48" />
    <text x="320" y="112" text-anchor="middle" class="t-ink">KRAKEND GATEWAY</text>
    <text x="320" y="128" text-anchor="middle" class="t-sm">ROUTES · JSON:API COMPOSITION · TENANT IDENTITY</text>

    <path class="line" marker-end="url(#ah-siv)" d="M320 140 L320 172" />

    <!-- address space -->
    <rect class="box" x="200" y="176" width="240" height="40" />
    <text x="320" y="194" text-anchor="middle" class="t-ink">ADDRESS SPACE</text>
    <text x="320" y="208" text-anchor="middle" class="t-sm">7M+ RECORDS</text>

    <path class="line" marker-end="url(#ah-siv)" d="M270 216 L228 248" />
    <path class="line" marker-end="url(#ah-siv)" d="M370 216 L472 248" />

    <!-- stores -->
    <rect class="box" x="150" y="252" width="150" height="34" />
    <text x="225" y="273" text-anchor="middle">POSTGRESQL</text>
    <rect class="box" x="400" y="252" width="150" height="34" />
    <text x="475" y="273" text-anchor="middle">OPENSEARCH</text>

    <path class="line dash" marker-end="url(#ah-siv)" d="M300 269 L398 269" />
    <text x="349" y="263" text-anchor="middle" class="t-accent">KAFKA</text>

    <!-- legacy -->
    <rect class="box dash" x="10" y="176" width="90" height="34" />
    <text x="55" y="197" text-anchor="middle" class="t-sm">LEGACY</text>
    <path class="line dash" marker-end="url(#ah-siv)" d="M100 193 L120 193 L120 269 L148 269" />
    <text x="10" y="232" class="t-sm">EXPAND / CONTRACT</text>
    <text x="10" y="244" class="t-sm">ZERO DOWNTIME</text>
  </svg>
</div>
