---
/** 05 — Role separation: judgment at the edges, bounded work in the middle. */
const workers = [0, 1, 2];
---
<div class="plate-scroll" style="--plate-min: 34rem">
  <svg class="plate" viewBox="0 0 640 272" role="img"
       aria-label="Diagram: a planner or lead agent fans work out to three bounded implementation workers, each in an isolated worktree, and their output converges on a review and verification step.">
    <defs>
      <marker id="ah-so" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0 L8 4 L0 8 z" class="head" />
      </marker>
    </defs>

    <rect class="box-in" x="10" y="98" width="130" height="48" />
    <text x="75" y="118" text-anchor="middle" class="t-ink">PLANNER / LEAD</text>
    <text x="75" y="134" text-anchor="middle" class="t-sm">CLAUDE CODE · CODEX</text>

    <line class="line" x1="140" y1="122" x2="170" y2="122" />
    <line class="line" x1="170" y1="46" x2="170" y2="198" />
    {workers.map((i) => (
      <>
        <path class="line" marker-end="url(#ah-so)" d={`M170 ${46 + i * 76} L216 ${46 + i * 76}`} />
        <rect class="box" x={220} y={46 + i * 76 - 19} width={200} height={38} />
        <text x={320} y={46 + i * 76 - 3} text-anchor="middle">IMPLEMENTATION WORKER</text>
        <text x={320} y={46 + i * 76 + 12} text-anchor="middle" class="t-sm">{`ISOLATED WORKTREE ${i + 1}`}</text>
        <path class="line" marker-end="url(#ah-so)" d={`M420 ${46 + i * 76} L466 ${46 + i * 76}`} />
      </>
    ))}
    <line class="line" x1="470" y1="46" x2="470" y2="198" />
    <path class="line" marker-end="url(#ah-so)" d="M470 122 L500 122" />

    <rect class="box-in" x="504" y="98" width="126" height="48" />
    <text x="567" y="118" text-anchor="middle" class="t-ink">REVIEW</text>
    <text x="567" y="134" text-anchor="middle" class="t-sm">DETERMINISTIC CHECKS</text>

    <line class="line-in" x1="10" y1="238" x2="630" y2="238" />
    <text x="10" y="258" class="t-sm">DEPENDENCY GRAPH</text>
    <text x="250" y="258" class="t-sm">EXECUTION WAVES</text>
    <text x="630" y="258" text-anchor="end" class="t-sm">VERIFIED RETRY, NOT HOPEFUL RETRY</text>
  </svg>
</div>
