---
/** 05 — Billing decides the role. */
const workers = [0, 1, 2];
const cy = (i: number) => 43 + i * 50;
---
<div class="plate-scroll" style="--plate-min: 36rem">
  <svg class="plate" viewBox="0 0 640 290" role="img"
       aria-label="Diagram: an orchestrator billed to a subscription delegates bounded tasks to workers billed to an API, each in its own git worktree. Their work merges onto one integration branch, and an assistant reports on the finished result.">
    <defs>
      <marker id="ah-so" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0 L8 4 L0 8 z" class="head" />
      </marker>
    </defs>

    <text x="10" y="14" class="t-accent">SUBSCRIPTION</text>
    <text x="215" y="14" class="t-accent">API · OPENROUTER</text>

    <!-- orchestrator -->
    <rect class="box-in" x="10" y="24" width="132" height="46" />
    <text x="76" y="45" text-anchor="middle" class="t-ink">ORCHESTRATOR</text>
    <text x="76" y="60" text-anchor="middle" class="t-sm">PLANS · DELEGATES</text>

    <path class="line" d="M142 47 L178 47" />
    <line class="line" x1="178" y1="43" x2="178" y2="143" />

    <!-- workers -->
    {workers.map((i) => (
      <>
        <path class="line" marker-end="url(#ah-so)" d={`M178 ${cy(i)} L211 ${cy(i)}`} />
        <rect class="box" x="215" y={cy(i) - 19} width="200" height="38" />
        <text x="315" y={cy(i) - 3} text-anchor="middle">WORKER</text>
        <text x="315" y={cy(i) + 11} text-anchor="middle" class="t-sm">{`OWN WORKTREE ${i + 1}`}</text>
        <path class="line" d={`M415 ${cy(i)} L452 ${cy(i)}`} />
      </>
    ))}
    <text x="215" y="178" class="t-sm">EACH WORKER MAY DELEGATE ONCE MORE</text>

    <line class="line" x1="452" y1="43" x2="452" y2="143" />
    <path class="line" marker-end="url(#ah-so)" d="M452 93 L486 93" />

    <!-- integration -->
    <rect class="box-in" x="490" y="70" width="140" height="46" />
    <text x="560" y="91" text-anchor="middle" class="t-ink">INTEGRATION</text>
    <text x="560" y="106" text-anchor="middle" class="t-sm">BRANCH</text>

    <!-- assistant -->
    <rect class="box" x="10" y="196" width="132" height="46" />
    <text x="76" y="217" text-anchor="middle" class="t-ink">ASSISTANT</text>
    <text x="76" y="232" text-anchor="middle" class="t-sm">READS · REPORTS</text>

    <path class="line dash" marker-end="url(#ah-so)" d="M560 116 L560 219 L146 219" />
    <text x="350" y="212" text-anchor="middle" class="t-sm">REPORTS ON FINISHED WORK</text>

    <line class="line-in" x1="10" y1="256" x2="630" y2="256" />
    <text x="10" y="276" class="t-sm">CHECKS DECIDE, NOT MODELS</text>
    <text x="270" y="276" class="t-sm">BOUNDS — WIDTH · DEPTH · TOTAL</text>
    <text x="630" y="276" text-anchor="end" class="t-sm">ONE ENGINE, THREE MODES</text>
  </svg>
</div>
