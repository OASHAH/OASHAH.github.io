---
/** 04 — Inquiry pipeline: bounded stages, escalation, gated send. */
const stages = [
  { k: "SEE",     e: "IMAGE · VIDEO · VOICE" },
  { k: "EXTRACT", e: "FIELDS · TRANSCRIPTS" },
  { k: "CHECK",   e: "OCR · VPIC · LOOKUPS" },
  { k: "DECIDE",  e: "DETERMINISTIC RULES" },
  { k: "BUILD",   e: "QUOTE · MESSAGE" },
];
const X = (i: number) => 20 + i * 166;
const W = 140;
---
<div class="plate-scroll" style="--plate-min: 52rem">
  <svg class="plate" viewBox="0 0 960 300" role="img"
       aria-label="Diagram: the Swoop inquiry pipeline runs five bounded stages — see, extract, check, decide, build — each accepting a different class of evidence. Uncertain reads escalate to a stronger model or an operator, every stage stays manually executable, and outbound messages pass a send gate.">
    <defs>
      <marker id="ah-sw" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0 L8 4 L0 8 z" class="head" />
      </marker>
    </defs>

    <!-- escalation -->
    <rect class="box dash" x="352" y="20" width="256" height="34" />
    <text x="480" y="41" text-anchor="middle" class="t-accent">ESCALATE — STRONGER MODEL OR OPERATOR</text>
    <path class="line dash" marker-end="url(#ah-sw)" d="M422 108 L422 56" />
    <path class="line dash" marker-end="url(#ah-sw)" d="M540 56 L540 108" />

    <!-- inbound -->
    <text x="20" y="41" class="t-ink">INBOUND</text>
    <text x="20" y="57" class="t-sm">WHATSAPP CLOUD API</text>
    <path class="line" marker-end="url(#ah-sw)" d="M40 66 L40 106" />

    <!-- stages -->
    {stages.map((s, i) => (
      <>
        <rect class="box" x={X(i)} y={110} width={W} height={52} />
        <text x={X(i) + W / 2} y={134} text-anchor="middle" class="t-ink">{s.k}</text>
        <text x={X(i) + W / 2} y={151} text-anchor="middle" class="t-sm">{s.e}</text>
        {i < stages.length - 1 && (
          <path class="line" marker-end="url(#ah-sw)" d={`M${X(i) + W} 136 L${X(i + 1) - 4} 136`} />
        )}
      </>
    ))}

    <!-- send gate -->
    <path class="line" marker-end="url(#ah-sw)" d="M824 136 L852 136" />
    <rect class="box-in" x="856" y="110" width="88" height="52" />
    <text x="900" y="132" text-anchor="middle" class="t-ink">SEND</text>
    <text x="900" y="148" text-anchor="middle" class="t-ink">GATE</text>
    <path class="line" marker-end="url(#ah-sw)" d="M900 162 L900 190" />
    <text x="900" y="206" text-anchor="middle" class="t-sm">CUSTOMER · SUPPLIER</text>

    <!-- manual rail -->
    <path class="line" d="M20 200 L20 214 L824 214 L824 200" />
    <text x="422" y="234" text-anchor="middle">EVERY AUTOMATED STAGE REMAINS MANUALLY EXECUTABLE</text>

    <!-- footing -->
    <line class="line-in" x1="20" y1="258" x2="940" y2="258" />
    <text x="20" y="278" class="t-sm">BOUNDED RETRIES</text>
    <text x="300" y="278" class="t-sm">STRUCTURED OUTPUTS</text>
    <text x="560" y="278" class="t-sm">TIERED MODEL ROUTING</text>
    <text x="940" y="278" text-anchor="end" class="t-sm">HUMAN OVERRIDE ON THE REMAINDER</text>
  </svg>
</div>
