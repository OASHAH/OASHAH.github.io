---
/** 07 — Deployment image, before and after multi-stage builds. */
const scale = 460 / 2048;
---
<div class="plate-scroll" style="--plate-min: 30rem">
  <svg class="plate" viewBox="0 0 640 130" role="img"
       aria-label="Chart: the deployment image measured 2048 megabytes with a single-stage Docker build and 170 megabytes after multi-stage builds, drawn to scale.">
    <text x="10" y="18" class="t-sm">DEPLOYMENT IMAGE · DRAWN TO SCALE</text>

    <text x="10" y="48" class="t-sm">SINGLE-STAGE</text>
    <rect class="box-in" x="120" y="36" width={2048 * scale} height="16" />
    <text x={124 + 2048 * scale} y="48" class="t-ink">2 GB</text>

    <text x="10" y="82" class="t-sm">MULTI-STAGE</text>
    <rect class="box-in" x="120" y="70" width={Math.max(170 * scale, 2)} height="16" />
    <text x={124 + 170 * scale} y="82" class="t-ink">170 MB</text>

    <line class="line-in" x1="10" y1="102" x2="630" y2="102" />
    <text x="10" y="121" class="t-sm">THE VPS STOPPED RUNNING OUT OF MEMORY ON DEPLOY</text>
  </svg>
</div>
